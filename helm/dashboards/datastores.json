    {
      "id": 14,
      "type": "table",
      "title": "Tables",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logodal-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logodal-pg"
          },
          "rawSql": "\nSELECT c.relname AS \"Table\",\n  c.reltuples::bigint AS \"Rows (estimate)\",\n  pg_total_relation_size(c.oid) AS \"Total size\",\n  pg_relation_size(c.oid) AS \"Data\",\n  pg_indexes_size(c.oid) AS \"Indexes\"\nFROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace\nWHERE c.relkind = 'r' AND n.nspname = 'public'\nORDER BY pg_total_relation_size(c.oid) DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Total size|Data|Indexes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
