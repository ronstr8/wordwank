    {
      "id": 18,
      "type": "table",
      "title": "Most-played words",
      "description": "Played by people.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logodal-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logodal-pg"
          },
          "rawSql": "\nSELECT upper(p.word) AS \"Word\", count(*) AS \"Times\", count(DISTINCT p.player_id) AS \"Players\",\n  round(avg(COALESCE(p.final_score, p.score)), 1) AS \"Avg pts\"\nFROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nWHERE $__timeFilter(g.created_at) AND pl.brain IS NULL\nGROUP BY 1 ORDER BY 2 DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
