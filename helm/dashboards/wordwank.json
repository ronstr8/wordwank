          "rawSql": "\nSELECT DISTINCT ON (length(p.word), upper(p.word)) upper(p.word) AS \"Word\", length(p.word) AS \"Letters\",\n  pl.nickname AS \"First by\", g.created_at AS \"When\"\nFROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nWHERE $__timeFilter(g.created_at) AND pl.brain IS NULL\nORDER BY length(p.word) DESC, upper(p.word), g.created_at LIMIT 20",
