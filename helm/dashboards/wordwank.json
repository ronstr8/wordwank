    {
      "id": 6,
      "type": "stat",
      "title": "Rounds won by people",
      "description": "Of rounds a person played in, the share a person won rather than a bot.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logodal-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logodal-pg"
          },
          "rawSql": "WITH winners AS (\n  SELECT DISTINCT ON (p.game_id) p.game_id, p.player_id, pl.brain IS NULL AS human\n  FROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nWHERE $__timeFilter(g.created_at)\n  ORDER BY p.game_id, COALESCE(p.final_score, p.score) DESC, p.created_at\n) SELECT avg(human::int) FROM winners WHERE game_id IN (SELECT p.game_id FROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nWHERE $__timeFilter(g.created_at) AND pl.brain IS NULL)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
