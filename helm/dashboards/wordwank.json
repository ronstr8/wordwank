    {
      "id": 16,
      "type": "table",
      "title": "Leaderboard",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logodal-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logodal-pg"
          },
          "rawSql": "\nWITH winners AS (\n  SELECT DISTINCT ON (p.game_id) p.game_id, p.player_id, pl.brain IS NULL AS human\n  FROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nWHERE $__timeFilter(g.created_at)\n  ORDER BY p.game_id, COALESCE(p.final_score, p.score) DESC, p.created_at\n)\nSELECT pl.nickname AS \"Player\",\n  CASE WHEN pl.brain IS NOT NULL THEN 'bot' ELSE '' END AS \" \",\n  count(DISTINCT p.game_id) AS \"Rounds\",\n  count(*) FILTER (WHERE w.player_id = p.player_id) AS \"Wins\",\n  round(100.0 * count(*) FILTER (WHERE w.player_id = p.player_id) / count(DISTINCT p.game_id), 1) AS \"Win %\",\n  sum(COALESCE(p.final_score, p.score)) AS \"Points\",\n  round(avg(COALESCE(p.final_score, p.score)), 1) AS \"Pts / word\",\n  (array_agg(upper(p.word) ORDER BY COALESCE(p.final_score, p.score) DESC))[1] AS \"Best word\"\nFROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nLEFT JOIN winners w ON w.game_id = p.game_id\nWHERE $__timeFilter(g.created_at)\nGROUP BY pl.id, pl.nickname, pl.brain\nORDER BY \"Points\" DESC\nLIMIT 25",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
