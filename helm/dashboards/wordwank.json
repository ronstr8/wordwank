    {
      "id": 9,
      "type": "timeseries",
      "title": "Rounds per day",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logodal-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
