        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logodal-pg"
          },
          "rawSql": "\nSELECT $__timeGroupAlias(g.created_at, '1d'),\n  count(*) FILTER (WHERE r.humans > 0) AS \"with people\",\n  count(*) FILTER (WHERE r.humans = 0 AND r.plays > 0) AS \"bots only\",\n  count(*) FILTER (WHERE r.plays = 0) AS \"nobody played\"\nFROM games g\nLEFT JOIN LATERAL (\n  SELECT count(*) AS plays, count(*) FILTER (WHERE pl.brain IS NULL) AS humans\n  FROM plays p JOIN players pl ON pl.id = p.player_id WHERE p.game_id = g.id\n) r ON true\nWHERE $__timeFilter(g.created_at)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
