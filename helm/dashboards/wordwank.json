          "rawSql": "\nSELECT upper(p.word) AS \"Word\", COALESCE(p.final_score, p.score) AS \"Points\", pl.nickname AS \"Player\", g.created_at AS \"When\"\nFROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nWHERE $__timeFilter(g.created_at)\nORDER BY 2 DESC, g.created_at DESC LIMIT 20",
