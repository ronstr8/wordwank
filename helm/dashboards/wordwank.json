          },
          "rawSql": "\nSELECT lpad(extract(hour FROM g.created_at AT TIME ZONE '$tz')::int::text, 2, '0') AS hour, count(*) AS words\nFROM plays p\n  JOIN games g ON g.id = p.game_id\n  JOIN players pl ON pl.id = p.player_id\nWHERE $__timeFilter(g.created_at) AND pl.brain IS NULL\nGROUP BY 1 ORDER BY 1",
